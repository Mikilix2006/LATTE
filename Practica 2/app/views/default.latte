{* Plantilla para mostrar los datos de MotoGP *}
{block content}
    <div class="league-container">
        {if $league}
            <h1>{$league['strLeague']}</h1>
            <img src="{$league['strBadge']}" alt="Badge" width="100">
            
            <p><strong>Formato:</strong> {$league['strSport']}</p>
            <p>{$league['strDescriptionEN']|truncate:500}</p>
            
            <div class="social-links">
                <a href="https://{$league['strWebsite']}" target="_blank">Sitio Web Oficial</a>
            </div>
        {else}
            <p>No se pudieron cargar los datos de la liga.</p>
        {/if}
    </div>
{/block}